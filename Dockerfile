
# Используем официальное базовое изображение Python 3.11
FROM python:3.11

# Определяем рабочую директорию в контейнере
WORKDIR /app

# Копируем файл app.py из локальной директории в рабочую директорию образа
COPY main/app.py .

# Запускаем команду по умолчанию при старте контейнера
CMD ["python", "app.py"]